# ============================================================
# PLANTILLA DE VARIABLES - Portafolio UGC
# ============================================================
# Copia este archivo como .env y reemplaza los valores.
# El archivo .env es gitignored y nunca se sube al repo.

# Contacto
CONTACT_EMAIL=tu_correo@ejemplo.com
WHATSAPP_NUMBER=52XXXXXXXXXX

# Redes sociales (TikTok e Instagram: solo el usuario, sin @ ni URLs)
TIKTOK_USERNAME=tu_usuario_tiktok
INSTAGRAM_USERNAME=tu_usuario_instagram
# Facebook: usuario (sin @), ID numérico, o URL completa
FACEBOOK_USERNAME_ID=tu_usuario_facebook

# URL pública del sitio, sin barra final (Open Graph y canónica)
SITE_URL=https://tu-usuario.github.io/tu-repo

# Foto de perfil (ruta relativa desde la raíz del repo)
OG_IMAGE_URL=assets/images/tu-foto.webp
PROFILE_IMAGE_PATH=assets/images/tu-foto-perfil.webp

# Analytics (GoatCounter - https://goatcounter.com)
GOATCOUNTER_CODE=tu_codigo

# PIN de /admin/ (solo se publica un hash, no el PIN en texto plano)
ADMIN_PIN=cambia-este-pin
